<?xml version="1.0" encoding="UTF-8"?>
<CPackWiXPatch>
    <CPackWiXFragment Id="#PRODUCT">
        <Property Id="CREATE_DESKTOP_SHORTCUT" Value="1" Secure="yes" />
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="立即运行 LoimReader" />
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
        <Property Id="WixUnelevatedShellExecTarget" Value="[INSTALL_ROOT]bin\LoimReader.exe" />
        <CustomAction Id="LaunchLoimReader" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixUnelevatedShellExec" Execute="immediate" Return="ignore" />
        <UI>
            <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchLoimReader" Order="1" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
        </UI>
    </CPackWiXFragment>
    <CPackWiXFragment Id="CM_SHORTCUT_DESKTOP_Runtime" Condition="CREATE_DESKTOP_SHORTCUT = 1" />
</CPackWiXPatch>
